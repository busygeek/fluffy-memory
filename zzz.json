// POST Use Case 4: Full Created Object with Extras
{
  "routeId": "post_full_object_response",
  "description": "POST endpoint returning full created object with extras",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/users",
    "collection": "users",
    "storageStrategy": "collection_file",
    "requiredBodyParams": ["name", "email"],
    "optionalBodyParams": ["age", "preferences"]
  },
  "responseConfig": {
    "statusCode": 201,
    "responseBody": "{{created_object_with_extras}}",
    "additionalFields": {
      "id": "{{created_record_guid}}",
      "createdAt": "{{current_timestamp}}",
      "version": "1.0",
      "status": "active",
      "permalink": "/users/{{created_record_guid}}"
    },
    "customHeaders": {
      "Location": "/api/users/{{created_record_guid}}",
      "X-Resource-Version": "1.0"
    },
    "delayMs": 300
  }
}

// Example Request:
POST /api/dynamic/users
{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "age": 28,
  "preferences": {
    "theme": "dark",
    "notifications": true
  }
}

// Expected Response:
HTTP 201 Created
Location: /api/users/usr-a1b2c3d4-e5f6-7890-abcd-ef1234567890
X-Resource-Version: 1.0
{
  "name": "Jane Smith",
  "email": "jane.smith@example.com",
  "age": 28,
  "preferences": {
    "theme": "dark",
    "notifications": true
  },
  "id": "usr-a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "createdAt": "2024-08-20T14:30:25",
  "version": "1.0",
  "status": "active",
  "permalink": "/users/usr-a1b2c3d4-e5f6-7890-abcd-ef1234567890"
}




