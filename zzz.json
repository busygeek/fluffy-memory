// PUT with Nested Validation and Response Transformation
{
  "routeId": "put_organization_structure",
  "description": "Update organization with nested department structure",
  "requestConfig": {
    "httpMethod": "PUT",
    "urlPattern": "/api/organizations/{id}",
    "collection": "organizations",
    "storageStrategy": "individual_file",
    "requiredPathParams": ["id"],
    "requiredBodyParams": [
      "name",
      "departments[].name",
      "departments[].manager.employeeId"
    ],
    "optionalBodyParams": [
      "departments[].budget.allocated",
      "departments[].employees[].name"
    ],
    "fieldRules": [
      {
        "fieldName": "departments[].manager.employeeId",
        "regexPattern": "^EMP[0-9]{5}$",
        "statusCode": 422,
        "message": "Employee ID must be EMP followed by 5 digits",
        "responseBody": {
          "error": "INVALID_EMPLOYEE_ID",
          "field": "departments[].manager.employeeId",
          "format": "EMP12345"
        }
      },
      {
        "fieldName": "departments[].budget.allocated",
        "regexPattern": "^[0-9]+(\\.00)?$",
        "statusCode": 422,
        "message": "Budget must be a whole number or with .00",
        "responseBody": {
          "error": "INVALID_BUDGET_FORMAT",
          "field": "departments[].budget.allocated"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "organization": "{{updated_object}}",
      "message": "Organization updated successfully"
    },
    "fieldsToExclude": [
      "departments[].budget.internal",
      "departments[].employees[].salary"
    ],
    "additionalFields": {
      "updatedAt": "{{current_timestamp}}",
      "version": "2.1"
    },
    "delayMs": 400
  }
}

// Example PUT Request:
PUT /api/dynamic/organizations/org-123
{
  "name": "Tech Corp Inc",
  "departments": [
    {
      "name": "Engineering",
      "manager": {
        "employeeId": "EMP12345",
        "name": "John Doe"
      },
      "budget": {
        "allocated": 500000.00,
        "internal": "sensitive_budget_data"
      },
      "employees": [
        {
          "name": "Alice Johnson",
          "role": "Senior Developer",
          "salary": 120000
        },
        {
          "name": "Bob Smith",
          "role": "DevOps Engineer", 
          "salary": 110000
        }
      ]
    },
    {
      "name": "Marketing",
      "manager": {
        "employeeId": "EMP67890",
        "name": "Jane Wilson"
      },
      "budget": {
        "allocated": 250000.00
      }
    }
  ]
}

// Expected Response:
HTTP 200 OK
{
  "organization": {
    "id": "org-123",
    "name": "Tech Corp Inc",
    "departments": [
      {
        "name": "Engineering",
        "manager": {
          "employeeId": "EMP12345",
          "name": "John Doe"
        },
        "budget": {
          "allocated": 500000.00
          // "internal" excluded
        },
        "employees": [
          {
            "name": "Alice Johnson",
            "role": "Senior Developer"
            // "salary" excluded
          },
          {
            "name": "Bob Smith",
            "role": "DevOps Engineer"
            // "salary" excluded
          }
        ]
      },
      {
        "name": "Marketing",
        "manager": {
          "employeeId": "EMP67890",
          "name": "Jane Wilson"
        },
        "budget": {
          "allocated": 250000.00
        }
      }
    ],
    "updatedAt": "2024-08-20T14:30:25"
  },
  "message": "Organization updated successfully",
  "updatedAt": "2024-08-20T14:30:25",
  "version": "2.1"
}

