// DELETE with Custom Response and Conditional Logic
{
  "routeId": "delete_user_account",
  "description": "Delete user account with custom response",
  "requestConfig": {
    "httpMethod": "DELETE",
    "urlPattern": "/api/users/{id}",
    "collection": "users",
    "storageStrategy": "individual_file",
    "requiredPathParams": ["id"],
    "customHeaders": {
      "Authorization": "Bearer token"
    }
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "message": "User account deleted successfully",
      "deletedUserId": "{{path.id}}",
      "deletedAt": "{{current_timestamp}}",
      "success": true
    },
    "conditionalResponses": [
      {
        "condition": "header:X-Soft-Delete=true",
        "statusCode": 200,
        "message": "User soft deleted",
        "responseBody": {
          "message": "User account soft deleted",
          "userId": "{{path.id}}",
          "softDeleted": true,
          "canRestore": true,
          "deletedAt": "{{current_timestamp}}"
        }
      },
      {
        "condition": "header:X-Archive=true",
        "statusCode": 202,
        "message": "User archived",
        "responseBody": {
          "message": "User account archived for compliance",
          "userId": "{{path.id}}",
          "archived": true,
          "retentionPeriod": "7 years",
          "archivedAt": "{{current_timestamp}}"
        }
      }
    ],
    "customHeaders": {
      "X-Operation": "DELETE",
      "X-Resource-Id": "{{path.id}}"
    },
    "delayMs": 150
  }
}

