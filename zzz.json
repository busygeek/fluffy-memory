// POST Product Filter with Complex Criteria
{
  "routeId": "post_products_filter",
  "description": "Filter products using POST with complex filter criteria",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/products/filter",
    "collection": "products",
    "storageStrategy": "collection_file",
    "requiredBodyParams": ["filters"],
    "optionalBodyParams": ["aggregations", "sort", "groupBy"],
    "fieldRules": [
      {
        "fieldName": "filters.price.min",
        "regexPattern": "^[0-9]+(\\.[0-9]{1,2})?$",
        "statusCode": 422,
        "message": "Minimum price must be a valid decimal",
        "responseBody": {
          "error": "INVALID_PRICE_FORMAT",
          "field": "filters.price.min"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "products": "{{filtered_results}}",
      "count": "{{total_count}}",
      "filters": "{{request_body.filters}}",
      "aggregations": "{{computed_aggregations}}"
    },
    "conditionalResponses": [
      {
        "condition": "query:includeStats=true",
        "statusCode": 200,
        "message": "Products with statistics",
        "responseBody": {
          "products": "{{filtered_results}}",
          "count": "{{total_count}}",
          "statistics": {
            "avgPrice": 299.99,
            "categories": ["electronics", "books"],
            "priceRange": {
              "min": 9.99,
              "max": 1299.99
            }
          }
        }
      }
    ],
    "delayMs": 450
  }
}

// Example Request:
POST /api/dynamic/products/filter
{
  "filters": {
    "price": {
      "min": 10.00,
      "max": 100.00
    },
    "category": ["electronics", "books"],
    "inStock": true
  },
  "sort": {
    "field": "price",
    "order": "asc"
  },
  "aggregations": ["category", "priceRange"]
}

// Expected Response:
HTTP 200 OK
{
  "products": [
    {
      "id": "1",
      "name": "Wireless Mouse",
      "category": "electronics",
      "price": 29.99,
      "inStock": true
    },
    {
      "id": "2",
      "name": "Programming Book",
      "category": "books",
      "price": 45.99,
      "inStock": true
    },
    {
      "id": "3",
      "name": "USB Cable",
      "category": "electronics", 
      "price": 12.99,
      "inStock": true
    }
  ],
  "count": 3,
  "filters": {
    "price": {
      "min": 10.00,
      "max": 100.00
    },
    "category": ["electronics", "books"],
    "inStock": true
  },
  "aggregations": {
    "categoryCount": {
      "electronics": 2,
      "books": 1
    },
    "priceRange": {
      "min": 12.99,
      "max": 45.99
    }
  }
}

// Example with Statistics:
POST /api/dynamic/products/filter?includeStats=true
{
  "filters": {
    "category": ["electronics"]
  }
}

// Expected Response with Statistics:
HTTP 200 OK
{
  "products": [
    {
      "id": "1",
      "name": "Laptop",
      "category": "electronics",
      "price": 1299.99
    },
    {
      "id": "2",
      "name": "Mouse",
      "category": "electronics",
      "price": 29.99
    }
  ],
  "count": 2,
  "statistics": {
    "avgPrice": 299.99,
    "categories": ["electronics", "books"],
    "priceRange": {
      "min": 9.99,
      "max": 1299.99
    }
  }
}





