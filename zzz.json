// Advanced Pagination with Search and Filters
{
  "routeId": "get_advanced_pagination",
  "description": "Advanced pagination with metadata and search",
  "requestConfig": {
    "httpMethod": "GET",
    "urlPattern": "/api/products/search",
    "collection": "products",
    "storageStrategy": "collection_file",
    "optionalQueryParams": ["offset", "limit", "category", "sortBy", "q"]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "products": "{{paginated_filtered_results}}",
      "pagination": {
        "offset": "{{query.offset}}",
        "limit": "{{query.limit}}",
        "total": "{{total_count}}",
        "returned": "{{returned_count}}",
        "hasNext": "{{has_next_page}}",
        "hasPrevious": "{{has_previous_page}}"
      },
      "filters": {
        "category": "{{query.category}}",
        "sortBy": "{{query.sortBy}}",
        "searchQuery": "{{query.q}}"
      },
      "meta": {
