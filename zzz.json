// GET with Path-Based Conditional Responses
{
  "routeId": "get_api_conditional_path",
  "description": "API endpoint with path-based conditional responses",
  "requestConfig": {
    "httpMethod": "GET",
    "urlPattern": "/api/data/{category}",
    "collection": "mixed_data",
    "storageStrategy": "collection_file",
    "requiredPathParams": ["category"],
    "optionalQueryParams": ["format", "version"]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "data": "{{filtered_results}}",
      "category": "{{path.category}}"
    },
    "conditionalResponses": [
      {
        "condition": "path:/premium",
        "statusCode": 200,
        "message": "Premium data access",
        "responseBody": {
          "data": "{{filtered_results}}",
          "category": "{{path.category}}",
          "premium": true,
          "features": ["advanced_analytics", "real_time_updates", "priority_support"]
        }
      },
      {
        "condition": "path:/analytics AND query:format=summary",
        "statusCode": 200,
        "message": "Analytics summary",
        "responseBody": {
          "summary": {
            "totalRecords": "{{total_count}}",
            "category": "{{path.category}}",
            "lastUpdated": "{{current_timestamp}}"
          },
          "analytics": true
        }
      },
      {
        "condition": "query:version=v2",
        "statusCode": 200,
        "message": "API v2 response format",
        "responseBody": {
          "apiVersion": "2.0",
          "result": {
            "items": "{{filtered_results}}",
            "metadata": {
              "category": "{{path.category}}",
              "count": "{{total_count}}",
              "timestamp": "{{current_timestamp}}"
            }
          }
        }
      }
    ],
    "delayMs": 150
  }
}

