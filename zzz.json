// Student Registration with Complex Nested Validation
{
  "routeId": "post_student_registration",
  "description": "Student registration with nested validation",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/students",
    "collection": "students",
    "storageStrategy": "collection_file",
    "requiredBodyParams": [
      "name",
      "email",
      "student.id",
      "student.departments[].name",
      "student.departments[].building.id"
    ],
    "optionalBodyParams": [
      "student.preferences.notifications",
      "contactInfo.phone",
      "contactInfo.address.street"
    ],
    "fieldRules": [
      {
        "fieldName": "student.departments[].building.id",
        "regexPattern": "^[0-9][A-Z]$",
        "statusCode": 422,
        "message": "Building ID must be 2-character alphanumeric (e.g., 2A, 4C)",
        "responseBody": {
          "error": "INVALID_BUILDING_ID",
          "field": "student.departments[].building.id",
          "pattern": "Must be 2 characters: digit + letter (e.g., 2A, 4C)",
          "examples": ["1A", "2B", "9Z"]
        }
      },
      {
        "fieldName": "student.id",
        "regexPattern": "^STU[0-9]{6}$",
        "statusCode": 422,
        "message": "Student ID must be STU followed by 6 digits",
        "responseBody": {
          "error": "INVALID_STUDENT_ID",
          "field": "student.id",
          "pattern": "STU123456"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 201,
    "responseBody": {
      "studentId": "{{created_record_guid}}",
      "registrationNumber": "{{generated_6_digit_id}}",
      "message": "Student registered successfully"
    },
    "fieldsToExclude": ["student.preferences.private"],
    "additionalFields": {
      "registeredAt": "{{current_timestamp}}",
      "academicYear": "2024-2025"
    },
    "delayMs": 300
  }
}

