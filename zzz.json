// GET Use Case 4: Pagination with Offset/Limit
{
  "routeId": "get_with_pagination",
  "description": "GET endpoint with offset/limit pagination",
  "requestConfig": {
    "httpMethod": "GET",
    "urlPattern": "/api/orders",
    "collection": "orders",
    "storageStrategy": "collection_file",
    "optionalQueryParams": ["offset", "limit", "sortBy", "sortOrder"]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "data": "{{paginated_results}}",
      "pagination": {
        "offset": "{{query.offset}}",
        "limit": "{{query.limit}}",
        "total": "{{total_count}}",
        "hasNext": "{{has_next_page}}",
        "hasPrevious": "{{has_previous_page}}"
