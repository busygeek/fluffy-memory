// Advanced Conditional Response Based on Headers and Query Params
{
  "routeId": "get_user_conditional",
  "description": "GET user with conditional responses based on headers",
  "requestConfig": {
    "httpMethod": "GET",
    "urlPattern": "/api/users/{id}",
    "collection": "users", 
    "storageStrategy": "collection_file",
    "requiredPathParams": ["id"],
    "customHeaders": {
      "Authorization": "Bearer token"
    }
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": "{{found_user}}",
    "fieldsToExclude": ["password", "internalNotes"],
    "conditionalResponses": [
      {
        "condition": "header:X-User-Role=admin",
        "statusCode": 200,
        "message": "Full user data for admin",
        "responseBody": {
          "user": "{{found_user}}",
          "adminView": true,
          "internalData": {
            "lastLogin": "2024-08-20T10:15:30",
            "loginCount": 45
          }
        }
      },
      {
        "condition": "header:X-User-Role=public",
        "statusCode": 200,
        "message": "Public user data",
        "responseBody": {
          "id": "{{path.id}}",
          "name": "{{found_user.name}}",
          "publicProfile": true,
          "limitedView": true
        }
      },
      {
        "condition": "query:format=summary AND header:X-Client=mobile",
        "statusCode": 200,
        "message": "Mobile summary view",
        "responseBody": {
          "id": "{{path.id}}",
          "name": "{{found_user.name}}",
          "avatar": "{{found_user.profile.avatar}}",
          "mobileOptimized": true
        }
      }
    ],
    "delayMs": 180
  }
}

