// POST Use Case 1: Simple GUID Response
{
  "routeId": "post_simple_guid",
  "description": "POST endpoint returning only GUID",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/simple-create",
    "collection": "simple_records",
    "storageStrategy": "collection_file",
    "requiredBodyParams": ["name"],
    "optionalBodyParams": ["data"]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "guid": "{{created_record_guid}}"
    },
    "delayMs": 100
  }
}

// Example Request:
POST /api/dynamic/simple-create
{
  "name": "Test Record",
  "data": "Some additional data"
}

// Expected Response:
HTTP 200 OK
{
  "guid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
}

// ========================================

// POST Use Case 2: 201 with 6-digit contactId
{
  "routeId": "post_contact_creation",
  "description": "POST endpoint creating contact with 6-digit ID",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/contacts",
    "collection": "contacts",
    "storageStrategy": "individual_file",
    "requiredBodyParams": ["firstName", "lastName", "email"],
    "optionalBodyParams": ["phone", "company"],
    "fieldRules": [
      {
        "fieldName": "email",
        "regexPattern": "^[\\w\\.-]+@[\\w\\.-]+\\.[a-zA-Z]{2,}$",
        "statusCode": 422,
        "message": "Invalid email format",
        "responseBody": {
          "error": "INVALID_EMAIL",
          "field": "email",
          "message": "Please provide a valid email address"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 201,
    "responseBody": {
      "responseObject": {
        "contactId": "{{generated_6_digit_id}}",
        "success": true
      }
    },
    "customHeaders": {
      "Location": "/api/contacts/{{generated_6_digit_id}}"
    },
    "delayMs": 200
  }
}

// Example Request:
POST /api/dynamic/contacts
{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@example.com",
  "phone": "+1-555-0123",
  "company": "Tech Corp"
}

// Expected Response:
HTTP 201 Created
Location: /api/contacts/123456
{
  "responseObject": {
    "contactId": "123456",
    "success": true
  }
}

// Example Validation Error:
POST /api/dynamic/contacts
{
  "firstName": "John",
  "lastName": "Doe",
  "email": "invalid-email"
}

// Expected Error Response:
HTTP 422 Unprocessable Entity
{
  "error": "INVALID_EMAIL",
  "field": "email",
  "message": "Please provide a valid email address"
}

