// PATCH with Partial Updates
{
  "routeId": "patch_user_profile",
  "description": "PATCH user profile with partial updates",
  "requestConfig": {
    "httpMethod": "PATCH",
    "urlPattern": "/api/users/{id}/profile",
    "collection": "users",
    "storageStrategy": "collection_file",
    "requiredPathParams": ["id"],
    "optionalBodyParams": ["name", "bio", "preferences.theme", "preferences.notifications"],
    "fieldRules": [
      {
        "fieldName": "bio",
        "regexPattern": "^.{0,500}$",
        "statusCode": 422,
        "message": "Bio cannot exceed 500 characters",
        "responseBody": {
          "error": "BIO_TOO_LONG",
          "field": "bio",
          "maxLength": 500
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "user": "{{updated_object}}",
      "changes": "{{request_body}}",
      "message": "Profile updated successfully"
    },
    "fieldsToExclude": ["password", "internalNotes"],
    "additionalFields": {
      "lastModified": "{{current_timestamp}}",
      "patchId": "{{generated_guid}}"
    },
    "customHeaders": {
      "X-Last-Modified": "{{current_timestamp}}",
      "X-Patch-ID": "{{generated_guid}}"
    },
    "delayMs": 200
  }
}

