// POST Search Users with Complex Criteria
{
  "routeId": "post_users_search",
  "description": "Search users using POST with complex search criteria",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/users/search",
    "collection": "users",
    "storageStrategy": "collection_file",
    "requiredBodyParams": [],
    "optionalBodyParams": ["name", "email", "age", "city", "skills", "dateRange"],
    "customHeaders": {
      "Authorization": "Bearer token"
    },
    "fieldRules": [
      {
        "fieldName": "email",
        "regexPattern": "^[\\w\\.-]+@[\\w\\.-]+\\.[a-zA-Z]{2,}$",
        "statusCode": 400,
        "message": "Invalid email format in search criteria",
        "responseBody": {
          "error": "INVALID_EMAIL_SEARCH",
          "field": "email"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 200,
    "responseBody": {
      "results": "{{search_results}}",
      "total": "{{total_count}}",
      "searchCriteria": "{{request_body}}"
    },
    "conditionalResponses": [
      {
        "condition": "query:fast=true AND header:X-Fast-Search=enabled",
        "statusCode": 200,
        "message": "Fast search results",
        "responseBody": {
          "results": "{{search_results}}",
          "total": "{{total_count}}",
          "cached": true,
          "searchTime": "5ms"
        }
      }
    ],
    "customHeaders": {
      "X-Search-Time": "{{processing_time}}",
      "X-Total-Results": "{{total_count}}"
    },
    "delayMs": 300
  }
}

// Example Request:
POST /api/dynamic/users/search
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
{
  "name": "john",
  "age": 25,
  "city": "New York",
  "skills": ["javascript", "react"],
  "dateRange": {
    "from": "2023-01-01",
    "to": "2024-01-01"
  }
}

// Expected Response:
HTTP 200 OK
X-Search-Time: 245ms
X-Total-Results: 2
{
  "results": [
    {
      "id": "1",
      "name": "John Doe",
      "email": "john.doe@example.com",
      "age": 25,
      "city": "New York",
      "skills": ["javascript", "react", "node.js"]
    },
    {
      "id": "2", 
      "name": "John Smith",
      "email": "john.smith@example.com",
      "age": 25,
      "city": "New York",
      "skills": ["javascript", "react", "python"]
    }
  ],
  "total": 2,
  "searchCriteria": {
    "name": "john",
    "age": 25,
    "city": "New York",
    "skills": ["javascript", "react"],
    "dateRange": {
      "from": "2023-01-01",
      "to": "2024-01-01"
    }
  }
}

// Example Fast Search Request:
POST /api/dynamic/users/search?fast=true
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
X-Fast-Search: enabled
{
  "name": "john"
}

// Expected Fast Search Response:
HTTP 200 OK
{
  "results": [
    {
      "id": "1",
      "name": "John Doe",
      "email": "john.doe@example.com"
    }
  ],
  "total": 1,
  "cached": true,
  "searchTime": "5ms"
}

