// Product with Complex Nested Structure and Array Validation
{
  "routeId": "post_product_catalog",
  "description": "Product catalog with nested itemization",
  "requestConfig": {
    "httpMethod": "POST",
    "urlPattern": "/api/products",
    "collection": "products",
    "storageStrategy": "individual_file",
    "requiredBodyParams": [
      "name",
      "itemization.itemnum",
      "itemization.pricing.base",
      "categories[].name"
    ],
    "optionalBodyParams": [
      "itemization.pricing.discounts[].percentage",
      "specifications.dimensions.height"
    ],
    "fieldRules": [
      {
        "fieldName": "itemization.itemnum",
        "regexPattern": "^ITM-[0-9]{4}-[A-Z]{2}$",
        "statusCode": 422,
        "message": "Item number must follow format ITM-XXXX-YY",
        "responseBody": {
          "error": "INVALID_ITEM_NUMBER",
          "field": "itemization.itemnum",
          "format": "ITM-1234-AB"
        }
      },
      {
        "fieldName": "itemization.pricing.discounts[].percentage",
        "regexPattern": "^([0-9]|[1-9][0-9])$",
        "statusCode": 422,
        "message": "Discount percentage must be 0-99",
        "responseBody": {
          "error": "INVALID_DISCOUNT_PERCENTAGE",
          "field": "itemization.pricing.discounts[].percentage",
          "range": "0-99"
        }
      }
    ]
  },
  "responseConfig": {
    "statusCode": 201,
    "responseBody": {
      "productId": "{{created_record_guid}}",
      "itemNumber": "{{request_body.itemization.itemnum}}",
      "success": true
    },
    "fieldsToExclude": [
      "itemization.pricing.cost",
      "metadata.internal"
    ],
    "delayMs": 250
  }
}

